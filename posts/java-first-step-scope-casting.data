i-dark:#E1E4E8\"> x);</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">        } </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// x 생존 종료</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">        // System.out.println(\"main x = \" + x);</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">            // java: cannot find symbol</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">            // symbol:   variable x</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">        System.out.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">println</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"main m = \"</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> m);</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    } </span><span style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">// m 생존 종료</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></figure>\n<ul>\n<li>변수는 선언 위치에 따라 지역 변수, 멤버 변수(클래스, 인스턴스의 변수)와 같이 분류된다.</li>\n<li>지역 변수(Local Variable)\n<ul>\n<li>특정 지역에서만 사용할 수 있는 변수</li>\n<li>특정 지역을 벗어나면 사용할 수 없다.\n<ul>\n<li>특정 지역이란 변수가 선언된 코드 블록(<span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>{}</span></span></code></span>)을 의미한다.</li>\n</ul>\n</li>\n<li>자신이 선언된 코드 블록(<span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>{}</span></span></code></span>) 안에서만 생존하고, 해당 블록을 벗어나면 제거된다. 이후에는 접근할 수 없다.</li>\n</ul>\n</li>\n<li>이렇게 변수의 접근 가능한 범위를 <strong>스코프(Scope)</strong> 라고 한다.</li>\n</ul>\n<h3 id=\"스코프의-존재-이유\"><a class=\"anchor\" aria-label=\"Link to heading\" href=\"#스코프의-존재-이유\">스코프의 존재 이유</a></h3>\n<figure data-rehype-pretty-code-figure=\"\"><pre tabindex=\"0\" data-language=\"java\" data-theme=\"github-light github-dark\"><code data-language=\"java\" data-theme=\"github-light github-dark\" style=\"display: grid;\"><span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> Scope3_1</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> void</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">args</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">        int</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> m </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 10</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">        int</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> temp </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">        if</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> (m </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">            temp </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> m </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 2</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">            System.out.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">println</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"temp = \"</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> temp);</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">        }</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">        System.out.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">println</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"m = \"</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> m);</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}</span></span></code></pre></figure>\n<ul>\n<li>위 코드는 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 조건에 따라 변수 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>m</span></span></code></span>을 2배 증가시켜 출력하는 코드이다.</li>\n<li>임시 변수 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>를 사용했지만, <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>는 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 조건이 만족할 때 임시로 사용하는 변수이다.</li>\n<li>그런데 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>는 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>main()</span></span></code></span> 블록 안에 선언되어 있다. 이에 따라 다음과 같은 문제가 발생할 수 있다.\n<ul>\n<li><strong>비효율적인 메모리 사용</strong>\n<ul>\n<li><span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>는 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 안에서만 사용되지만, <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>main()</span></span></code></span> 블록이 종료될 때 까지 메모리에 유지된다.</li>\n<li><span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 안에 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>를 선언했다면 자바를 구현하는 곳에서 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 코드 블록 종료 시점에 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>를 메모리에서 제거하여 더 효율적인 메모리 사용이 가능하다.</li>\n</ul>\n</li>\n<li><strong>코드 복잡성 증가</strong>\n<ul>\n<li><span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>는 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span> 안에서만 필요하기 때문에 그 안에서만 사용하면 된다.</li>\n<li><span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>if</span></span></code></span>가 끝나도 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>main</span></span></code></span>에서 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>에 접근할 수 있기 때문에 누군가 이 코드를 유지보수 할 때 m은 물론이고 <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>temp</span></span></code></span>도 신경써야 한다.</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n<h3 id=\"for-vs-whlie-스코프를-통해-생각해보기\"><a class=\"anchor\" aria-label=\"Link to heading\" href=\"#for-vs-whlie-스코프를-통해-생각해보기\"><span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>for</span></span></code></span> vs <span data-rehype-pretty-code-figure=\"\"><code data-language=\"plaintext\" data-theme=\"github-light github-dark\"><span data-line=\"\"><span>whlie</span></span></code></span> 스코프를 통해 생각해보기</a></h3>\n<figure data-rehype-pretty-code-figure=\"\"><pre tabindex=\"0\" data-language=\"java\" data-theme=\"github-light github-dark\"><code data-language=\"java\" data-theme=\"github-light github-dark\" style=\"display: grid;\"><span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">public</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> While2_3</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span data-line=\"\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">    public</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> static</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\"> void</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> main</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">[] </span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFAB70\">args</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n