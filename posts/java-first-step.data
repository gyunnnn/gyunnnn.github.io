[{"_1":2},"routes/post",{"_3":4},"data",{"_5":6,"_7":8,"_9":-5,"_10":-5,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22},"post",{"_29":35,"_31":36,"_66":77,"_78":79,"_58":59,"_80":81},"chars",160,"updated","thumbnail","excerpt","업무 변경으로 Java를 빠르게 익히고자 강의 수강 후 정리한다. 기존에 다른 프로그래밍 언어를 학습했던 적이 있으므로, 몰랐던 내용이거나 새로 알게 된 부분, 애매하거나 헷갈렸던 부분만 다시 정리한다. 강의 링크…","html","<h2 id=\"자바-첫걸음\"><a class=\"anchor\" aria-label=\"Link to heading\" href=\"#자바-첫걸음\">자바 첫걸음</a></h2>\n<ul>\n<li>업무 변경으로 Java를 빠르게 익히고자 강의 수강 후 정리한다.</li>\n<li>기존에 다른 프로그래밍 언어를 학습했던 적이 있으므로, 몰랐던 내용이거나 새로 알게 된 부분, 애매하거나 헷갈렸던 부분만 다시 정리한다.</li>\n<li><a href=\"https://www.inflearn.com/course/%EA%B9%80%EC%98%81%ED%95%9C%EC%9D%98-%EC%9E%90%EB%B0%94-%EC%9E%85%EB%AC%B8/dashboard?cid=332505\">강의 링크</a></li>\n</ul>\n<h2 id=\"목차\"><a class=\"anchor\" aria-label=\"Link to heading\" href=\"#목차\">목차</a></h2>\n<ul>\n<li><a href=\"https://gyunnnn.github.io/posts/java-first-step-variable\">변수</a></li>\n<li><a href=\"https://gyunnnn.github.io/posts/java-first-step-operator\">연산자</a></li>\n<li><a href=\"https://gyunnnn.github.io/posts/java-first-step-conditionals\">조건문</a></li>\n<li>반복문</li>\n<li>스코프, 형변환</li>\n<li>배열</li>\n<li>메서드</li>\n</ul>","headings",[70,71],"related",[63,64,65],"localGraph",{"_43":44,"_45":46},"index",[23,24,25,26,27,28],{"_29":41,"_31":42},{"_29":39,"_31":40},{"_29":37,"_31":38},{"_29":35,"_31":36},{"_29":33,"_31":34},{"_29":30,"_31":32},"slug","serialization-deserialization","title","직렬화(Serialization)/역직렬화(Deserialization)","WWDC25-Whats-new-in-widgets","[WWDC25] What's new in widgets","java-first-step","김영한의 자바 입문 - 코드로 시작하는 자바 첫걸음","java-first-step-variable","김영한의 자바 입문 - 변수","java-first-step-operator","김영한의 자바 입문 - 연산자","java-first-step-conditionals","김영한의 자바 입문 - 조건문","nodes",[52,53,54,55],"links",[47,48,49],{"_50":41,"_51":35},{"_50":39,"_51":35},{"_50":37,"_51":35},"source","target",{"_56":41,"_57":42,"_58":59,"_60":62},{"_56":39,"_57":40,"_58":59,"_60":62},{"_56":37,"_57":38,"_58":59,"_60":62},